// Function1.cs
using System.Net;
using System.Threading.Tasks;
using Microsoft.Azure.Functions.Worker;
using Microsoft.Azure.Functions.Worker.Http;
using Microsoft.ApplicationInsights;

namespace MyFunctionApp
{
    public class HttpExampleFunction
    {
        private readonly TelemetryClient _telemetryClient;

        // The TelemetryClient is injected via dependency injection.
        public HttpExampleFunction(TelemetryClient telemetryClient)
        {
            _telemetryClient = telemetryClient;
        }

        [Function("HttpExampleFunction")]
        public async Task<HttpResponseData> Run(
            [HttpTrigger(AuthorizationLevel.Function, "get", "post")] HttpRequestData req,
            FunctionContext executionContext)
        {
            // Get the logger from the FunctionContext.
            var logger = executionContext.GetLogger("HttpExampleFunction");
            logger.LogInformation("Processing an HTTP request...");

            // Track a custom event via Application Insights.
            _telemetryClient.TrackEvent("HttpExampleFunctionTriggered");

            // Create a response with a simple text payload.
            HttpResponseData response = req.CreateResponse(HttpStatusCode.OK);
            response.Headers.Add("Content-Type", "text/plain; charset=utf-8");
            await response.WriteStringAsync("Hello from Azure Functions using Application Insights!");

            return response;
        }
    }
}
