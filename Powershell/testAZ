using Microsoft.ApplicationInsights;
using Microsoft.ApplicationInsights.Extensibility;
using Microsoft.Azure.Functions.Worker.Configuration;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;

namespace MyFunctionApp
{
    public class Program
    {
        public static void Main()
        {
            var host = new HostBuilder()
                // Ensure the Functions Worker and extensions (like HTTP) are configured.
                .ConfigureFunctionsWorkerDefaults(worker =>
                {
                    // Optionally: you can add custom configuration here.
                })
                // Configure DI services.
                .ConfigureServices((context, services) =>
                {
                    // Registers Application Insights; it automatically reads the instrumentation key
                    // from the APPINSIGHTS_INSTRUMENTATIONKEY environment variable.
                    services.AddApplicationInsightsTelemetryWorkerService();

                    // (Optional) If youâd like direct access to TelemetryConfiguration, you can register it:
                    // services.AddSingleton<TelemetryConfiguration>(sp =>
                    // {
                    //     var config = TelemetryConfiguration.CreateDefault();
                    //     config.InstrumentationKey = context.Configuration["APPINSIGHTS_INSTRUMENTATIONKEY"];
                    //     return config;
                    // });
                })
                .Build();

            host.Run();
        }
    }
}

