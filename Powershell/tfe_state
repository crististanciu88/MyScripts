stages:
- stage: UpdateTFEState
  displayName: "Download, update, and upload TFE state file"
  jobs:
  - job: MergeStateJob
    displayName: "Download state, merge update, and publish artifact"
    pool:
      vmImage: 'ubuntu-latest'
    steps:

    - script: |
        set -e

        echo "== Downloading the current TFE state file from Azure Storage =="
        # (Fill in your container name, storage account, blob name and output file)
        az storage blob download \
          --container-name mycontainer \
          --account-name mystorageaccount \
          --name tfe.tfstate \
          --file downloaded.tfstate

        echo "== Merging downloaded state with repository state file =="
        # In this example we use jq to merge the two JSON documents. Adjust the merge logic as needed.
        # Here we assume that the repository file is at repo/tfefiles/example.state.
        if ! command -v jq &> /dev/null; then
          echo "jq could not be found; please ensure it is installed"
          exit 1
        fi

        # Merge the two JSON files. This uses the jq "slurp" feature and a simple update (.[0] * .[1]).
        # You might need a more advanced merge depending on your state file structure.
        jq -s '.[0] * .[1]' downloaded.tfstate repo/tfefiles/example.state > updated.tfstate

        echo "== Uploading the updated state file back to Azure Storage =="
        az storage blob upload \
          --container-name mycontainer \
          --account-name mystorageaccount \
          --name tfe.tfstate \
          --file updated.tfstate \
          --overwrite

        echo "== Preparing to publish the updated state file as a pipeline artifact =="
        # Ensure the staging directory exists.
        mkdir -p "$(Build.ArtifactStagingDirectory)"
        cp updated.tfstate "$(Build.ArtifactStagingDirectory)/updated.tfstate"

        # The following logging command tells Azure DevOps to upload the artifact.
        echo "##vso[artifact.upload artifactname=UpdatedTFEState;]$(Build.ArtifactStagingDirectory)/updated.tfstate"
      displayName: "Download, merge, and upload TFE state file"

    # Alternatively, you can use the dedicated Publish Pipeline Artifact task.
