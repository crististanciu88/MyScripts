
# Get all IIS sites
$iisSites = Get-IISSite

# Initialize an array to store our results
$siteInfoCollection = @()

foreach ($site in $iisSites) {
    # Get the application pool for this site
    $appPoolName = $site.Applications[0].ApplicationPoolName
    $appPool = Get-IISAppPool -Name $appPoolName

    # Get bindings information
    $bindings = $site.Bindings
    $bindingInfo = @()

    foreach ($binding in $bindings) {
        $bindingInfo += @{
            Protocol = $binding.Protocol
            BindingInformation = $binding.BindingInformation
        }
    }

    # Create a custom object with all the required properties
    $siteInfo = [PSCustomObject]@{
        SiteName = $site.Name
        SiteState = $site.State
        AppPoolName = $appPoolName
        AppPoolState = $appPool.State
        Runtime = $appPool.ManagedRuntimeVersion
        AppPoolIdentity = $appPool.ProcessModel.IdentityType
        BindingInformation = ($bindingInfo.BindingInformation -join "; ")
        Protocol = ($bindingInfo.Protocol -join "; ")
        PhysicalPath = $site.Applications[0].VirtualDirectories[0].PhysicalPath
    }

    # Add to our collection
    $siteInfoCollection += $siteInfo
}

# Output the results
$siteInfoCollection | Format-Table -AutoSize
