Here's how you can structure your configuration to create multiple Azure Functions using `for_each` with external modules.

## 1. Variable Definitions (variables.tf)

```hcl
variable "azure_functions" {
  description = "Configuration for multiple Azure Functions"
  type = map(object({
    function_name      = string
    location           = string
    resource_group_name = string

    # Storage Account settings
    storage_account_tier              = string
    storage_account_replication_type  = string
    storage_account_kind              = string

    # App Service Plan settings
    service_plan_sku_name = string
    service_plan_os_type  = string

    # Function App settings
    function_app_version = string
    app_settings         = map(string)
    tags                 = map(string)
  }))

  default = {}
}
```

## 2. Terraform Variables (terraform.tfvars)

```hcl
azure_functions = {
  "function1" = {
    function_name      = "myfunction1"
    location           = "eastus"
    resource_group_name = "my-resource-group"

    storage_account_tier              = "Standard"
    storage_account_replication_type  = "LRS"
    storage_account_kind              = "StorageV2"

    service_plan_sku_name = "Y1"
    service_plan_os_type  = "Linux"

    function_app_version = "~4"
    app_settings = {
      "FUNCTIONS_WORKER_RUNTIME" = "python"
      "APPINSIGHTS_INSTRUMENTATIONKEY" = "your-instrumentation-key"
    }
    tags = {
      Environment = "Dev"
      Team        = "DevOps"
    }
  },
  "function2" = {
    function_name      = "myfunction2"
    location           = "eastus"
    resource_group_name = "my-resource-group"

    storage_account_tier              = "Standard"
    storage_account_replication_type  = "LRS"
    storage_account_kind              = "StorageV2"

    service_plan_sku_name = "Y1"
    service_plan_os_type  = "Linux"

    function_app_version = "~4"
    app_settings = {
      "FUNCTIONS_WORKER_RUNTIME" = "node"
      "APPINSIGHTS_INSTRUMENTATIONKEY" = "your-instrumentation-key"
    }
    tags = {
      Environment = "Prod"
      Team        = "DevOps"
    }
  }
}
```

## 3. Example Usage in functions.tf

```hcl
# Storage Account Module
module "function_storage" {
  source   = "./modules/storage-account"
  for_each = var.azure_functions

  name                     = each.value.function_name
  resource_group_name      = each.value.resource_group_name
  location                 = each.value.location
  account_tier             = each.value.storage_account_tier
  account_replication_type = each.value.storage_account_replication_type
  account_kind             = each.value.storage_account_kind
  tags                     = each.value.tags
}

# Service Plan Module
module "function_service_plan" {
  source   = "./modules/service-plan"
  for_each = var.azure_functions

  name                = each.value.function_name
  resource_group_name = each.value.resource_group_name
  location            = each.value.location
  sku_name            = each.value.service_plan_sku_name
  os_type             = each.value.service_plan_os_type
  tags                = each.value.tags
}

# Function App Module
module "function_app" {
  source   = "./modules/function-app"
  for_each = var.azure_functions

  name                = each.value.function_name
  resource_group_name = each.value.resource_group_name
  location            = each.value.location
  service_plan_id     = module.function_service_plan[each.key].id
  storage_account_name = module.function_storage[each.key].name
  storage_account_access_key = module.function_storage[each.key].primary_access_key
  version             = each.value.function_app_version
  app_settings        = each.value.app_settings
  tags                = each.value.tags
}
```

## Key Points:

1. The `azure_functions` variable is a map of objects where each key represents a unique identifier for each function configuration.

2. Each module uses `for_each` with the same variable, ensuring consistent iteration across all resources.

3. The `each.key` refers to the map key ("function1", "function2"), while `each.value` contains the configuration object.

4. Modules can reference outputs from other modules using the same key pattern (`module.function_service_plan[each.key].id`).

5. You can add or remove functions by modifying the `terraform.tfvars` file without changing the main configuration.
