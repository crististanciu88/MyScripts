param(
    [Parameter(Mandatory=$true)]
    [ValidateSet("Failover", "Fallback")]
    [string]$Mode
)

# Define server variables
$failoverServer = "failoverserver.com"
$fallbackServer = "fallbackserver.com"

# Configuration file path
$configFile = "your-config-file.xml"  # Replace with your actual config file path

# Function to create backup
function Backup-ConfigFile {
    param([string]$filePath)
    
    $backupDir = "Backups"
    if (!(Test-Path $backupDir)) {
        New-Item -ItemType Directory -Path $backupDir | Out-Null
    }

    $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $backupFile = Join-Path $backupDir ("BCM_Backup_" + (Split-Path $filePath -Leaf) + "_" + $timestamp + ".xml")

    try {
        Copy-Item -Path $filePath -Destination $backupFile -Force
        Write-Host "Backup created: $backupFile" -ForegroundColor Green
        return $backupFile
    }
    catch {
        Write-Error "Failed to create backup: $($_.Exception.Message)"
        exit 1
    }
}

# Function to check if backup already exists with BCM in name
function Test-BCMBackupExists {
    param([string]$filePath)

    $backupDir = "Backups"
    $fileName = Split-Path $filePath -Leaf
    $bcmPattern = "BCM_Backup_$fileName*"

    if (Test-Path $backupDir) {
        $existingBackups = Get-ChildItem -Path $backupDir -Filter $bcmPattern
        return ($existingBackups.Count -gt 0)
    }
    return $false
}

# Function to update server in configuration
function Update-ServerInConfig {
    param(
        [string]$filePath,
        [string]$oldServer,
        [string]$newServer
    )

    try {
        # Load the XML file
        [xml]$config = Get-Content -Path $filePath

        # Find the node with key="QueryCache"
        $queryCacheNode = $config.SelectSingleNode("//add[@key='QueryCache']")

        if ($queryCacheNode -eq $null) {
            Write-Error "QueryCache node not found in configuration file"
            return $false
        }

        # Get the current value
        $currentValue = $queryCacheNode.GetAttribute("value")

        if ($currentValue -eq $null) {
            Write-Error "Value attribute not found in QueryCache node"
            return $false
        }

        # Replace the server name
        $newValue = $currentValue -replace $oldServer, $newServer

        if ($currentValue -eq $newValue) {
            Write-Warning "No changes made. Server '$oldServer' not found in the value."
            return $false
        }

        # Update the value
        $queryCacheNode.SetAttribute("value", $newValue)

        # Save the modified XML
        $config.Save($filePath)

        Write-Host "Server updated successfully:" -ForegroundColor Green
        Write-Host "Old value: $currentValue" -ForegroundColor Yellow
        Write-Host "New value: $newValue" -ForegroundColor Green

        return $true
    }
    catch {
        Write-Error "Failed to update configuration: $($_.Exception.Message)"
        return $false
    }
}

# Main script execution
Write-Host "Starting configuration update in $Mode mode..." -ForegroundColor Cyan

# Check if config file exists
if (!(Test-Path $configFile)) {
    Write-Error "Configuration file not found: $configFile"
    exit 1
}

# Create backup if no BCM backup exists
if (!(Test-BCMBackupExists -filePath $configFile)) {
    Write-Host "Creating backup of current configuration..." -ForegroundColor Yellow
    $backupFile = Backup-ConfigFile -filePath $configFile
} else {
    Write-Host "BCM backup already exists. Skipping backup creation." -ForegroundColor Yellow
}

# Determine which servers to use based on mode
switch ($Mode) {
    "Failover" {
        $oldServer = $fallbackServer
        $newServer = $failoverServer
        Write-Host "Switching from $oldServer to $newServer" -ForegroundColor Cyan
    }
    "Fallback" {
        $oldServer = $failoverServer
        $newServer = $fallbackServer
        Write-Host "Switching from $oldServer to $newServer" -ForegroundColor Cyan
    }
}

# Update the configuration
$success = Update-ServerInConfig -filePath $configFile -oldServer $oldServer -newServer $newServer

if ($success) {
    Write-Host "Configuration update completed successfully!" -ForegroundColor Green
} else {
    Write-Host "Configuration update completed with warnings or no changes." -ForegroundColor Yellow
}

Write-Host "Script execution completed." -ForegroundColor Cyan
