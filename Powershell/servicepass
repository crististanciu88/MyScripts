[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string]$ConfigPath,

    [Parameter(Mandatory = $true, ParameterSetName = 'Failover')]
    [switch]$Failover,

    [Parameter(Mandatory = $true, ParameterSetName = 'Fallback')]
    [switch]$Fallback
)

# Ensure the file exists
if (-not (Test-Path -Path $ConfigPath)) {
    Write-Error "Config file not found: $ConfigPath"
    exit 1
}

# Validate mutual exclusivity (PowerShell parameter sets enforce this)
$targetServer = $null
if ($PSCmdlet.ParameterSetName -eq 'Failover') {
    $targetServer = 'testfailover.com'
} elseif ($PSCmdlet.ParameterSetName -eq 'Fallback') {
    $targetServer = 'testfallback.com'
} else {
    Write-Error "Specify either -Failover or -Fallback."
    exit 1
}

# 1) Backup the current configuration if no BCM backup exists
$dir  = Split-Path $ConfigPath -Parent
$name = [IO.Path]::GetFileName($ConfigPath)
$base = [IO.Path]::GetFileNameWithoutExtension($ConfigPath)
$ext  = [IO.Path]::GetExtension($ConfigPath)

# Check for existing BCM backups (names containing BCM)
$existingBCMBackups = Get-ChildItem -Path $dir -Filter "*BCM*" -File -ErrorAction SilentlyContinue

if (-not $existingBCMBackups -or $existingBCMBackups.Count -eq 0) {
    $backupPath = Join-Path $dir ("{0}.BCM_{1}{2}" -f $base, (Get-Date -Format 'yyyyMMddHHmmss'), $ext)
    Copy-Item -Path $ConfigPath -Destination $backupPath -ErrorAction Stop
    Write-Host "Backup created: $backupPath"
} else {
    Write-Host "BCM backup already exists. Skipping backup."
}

# 2) Update QueryCache value
# Load XML
try {
    $xmlDoc = New-Object -TypeName System.Xml.XmlDocument
    $xmlDoc.Load($ConfigPath)
} catch {
    Write-Error "Failed to load XML: $_"
    exit 1
}

# Find QueryCache nodes
$nodes = @()
$node1 = $xmlDoc.SelectNodes("//*[@key='QueryCache']")
$node2 = $xmlDoc.SelectNodes("//QueryCache")

if ($node1) { $nodes += $node1 }
if ($node2) { $nodes += $node2 }

$nodes = $nodes | Where-Object { $_ -ne $null } | Select-Object -Unique

if ($nodes.Count -eq 0) {
    Write-Warning "No nodes found for QueryCache. No changes applied."
} else {
    foreach ($node in $nodes) {
        # Prefer attribute 'value' if present (common for appSettings style)
        $attr = $node.Attributes["value"]
        if ($attr) {
            $cur = $attr.Value
            $newVal = $cur
            if ($cur -like "*testfailover.com*") {
                $newVal = $cur -replace "testfailover\.com", $targetServer
            } elseif ($cur -like "*testfallback.com*") {
                $newVal = $cur -replace "testfallback\.com", $targetServer
            }
            if ($newVal -ne $cur) {
                $attr.Value = $newVal
                Write-Host "Updated QueryCache value attribute: '$cur' -> '$newVal'"
            }
        } else {
            # Fallback to inner text if no value attribute
            $text = $node.InnerText
            $newText = $text
            if ($text -like "*testfailover.com*") {
                $newText = $text -replace "testfailover\.com", $targetServer
            } elseif ($text -like "*testfallback.com*") {
                $newText = $text -replace "testfallback\.com", $targetServer
            }
            if ($newText -ne $text) {
                $node.InnerText = $newText
                Write-Host "Updated QueryCache inner text: '$text' -> '$newText'"
            }
        }
    }

    # Save changes
    $xmlDoc.Save($ConfigPath)
    Write-Host "QueryCache updated to use $targetServer."
}
