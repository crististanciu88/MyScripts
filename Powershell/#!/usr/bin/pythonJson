import json
import sys

def update_state(source_path, destination_path):
    try:
        # Read source state
        with open(source_path, 'r') as f:
            source = json.load(f)

        # Read destination state
        with open(destination_path, 'r') as f:
            destination = json.load(f)

        # Update specific fields from source to destination
        fields_to_update = ['version', 'terraform_version', 'serial', 'lineage']
        for field in fields_to_update:
            if field in source:
                destination[field] = source[field]

        # Write back to destination file with original formatting preserved
        with open(destination_path, 'w') as f:
            # Use ensure_ascii=False to prevent escaping of special characters
            json.dump(destination, f, indent=2, ensure_ascii=False)
            f.write('\n')  # Add newline at end of file

        print(f"Successfully updated {destination_path} with values from {source_path}")

    except Exception as e:
        print(f"Error: {str(e)}")
        sys.exit(1)

if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python update_state.py <source.state> <destination.state>")
        sys.exit(1)

    source_file = sys.argv[1]
    destination_file = sys.argv[2]
    update_state(source_file, destination_file)
