#!/usr/bin/env python3
import sys
import json

def load_json(filename):
    with open(filename, "r", encoding="utf-8") as f:
        return json.load(f)

def write_json(filename, data):
    # ensure_ascii=False prevents characters like &, <, or > from being automatically
    # converted into Unicode escapes.
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")

def main():
    if len(sys.argv) != 3:
        sys.stderr.write("Usage: {} source.state destination.state\n".format(sys.argv[0]))
        sys.exit(1)

    source_file = sys.argv[1]
    dest_file = sys.argv[2]

    # Load JSON files
    try:
        source_json = load_json(source_file)
    except Exception as e:
        sys.stderr.write("Error reading {}: {}\n".format(source_file, e))
        sys.exit(1)

    try:
        dest_json = load_json(dest_file)
    except Exception as e:
        sys.stderr.write("Error reading {}: {}\n".format(dest_file, e))
        sys.exit(1)

    # List of keys to update from source into destination
    keys_to_update = ["version", "terraform_version", "serial", "lineage"]

    for key in keys_to_update:
        if key in source_json:
            # Update the value in destination if present in source.
            dest_json[key] = source_json[key]
        else:
            sys.stderr.write("Warning: Key '{}' not found in source file.\n".format(key))

    # Write out the updated destination JSON file, using:
    #   - indent=2 for readability,
    #   - ensure_ascii=False so that characters &, < and > are not replaced with Unicode escapes.
    try:
        write_json(dest_file, dest_json)
    except Exception as e:
        sys.stderr.write("Error writing {}: {}\n".format(dest_file, e))
        sys.exit(1)

if __name__ == "__main__":
    main()
