# Parameters
$GitLabUrl = "https://gitlab.com/api/v4"  # Change if using self-hosted GitLab
$PrivateToken = "your-personal-access-token"  # Replace with your PAT
$ProjectIds = @(123, 456, 789)  # Replace with your project IDs

# Headers for API requests
$headers = @{
    "Private-Token" = $PrivateToken
}

# Initialize results array
$results = @()

foreach ($projectId in $ProjectIds) {
    try {
        Write-Host "Processing project ID: $projectId"
        
        # Get all branches starting with 'rel'
        $branchesUrl = "$GitLabUrl/projects/$projectId/repository/branches?search=^rel"
        $branches = Invoke-RestMethod -Uri $branchesUrl -Headers $headers -Method Get
        
        if ($branches.Count -eq 0) {
            Write-Host "No release branches found for project $projectId"
            continue
        }

        foreach ($branch in $branches) {
            $branchName = $branch.name
            Write-Host "  Processing branch: $branchName"

            # Get the latest commit
            $commitUrl = "$GitLabUrl/projects/$projectId/repository/commits/$($branch.commit.id)"
            $commit = Invoke-RestMethod -Uri $commitUrl -Headers $headers -Method Get

            # Get open merge requests for this branch
            $mrUrl = "$GitLabUrl/projects/$projectId/merge_requests?state=opened&source_branch=$branchName"
            $mergeRequests = Invoke-RestMethod -Uri $mrUrl -Headers $headers -Method Get

            # Create result object
            $result = [PSCustomObject]@{
                ProjectID      = $projectId
                BranchName    = $branchName
                LastCommit    = $commit.title
                Author        = $commit.author_name
                CommitDate    = $commit.committed_date
                MRCount       = $mergeRequests.Count
                MRs           = if ($mergeRequests.Count -gt 0) {
                    ($mergeRequests | ForEach-Object { "!$($_.iid) $($_.title)" }) -join "`n"
                } else { "None" }
            }

            $results += $result
        }
    }
    catch {
        Write-Warning "Error processing project $projectId : $_"
    }
}

# Output results as a formatted table
$results | Format-Table -AutoSize -Wrap -Property ProjectID, BranchName, Author, LastCommit, MRCount

# Optional: Export to CSV
$results | Export-Csv -Path "GitLabReleaseBranchesReport.csv" -NoTypeInformation

# Optional: Create a more visual chart
if ($results.Count -gt 0) {
    # Create a bar chart of branches per project
    $chartData = $results | Group-Object ProjectID | ForEach-Object {
        [PSCustomObject]@{
            ProjectID = $_.Name
            BranchCount = $_.Count
        }
    }

    # Display chart using Out-ConsoleGridView if available
    if (Get-Command -Name Out-ConsoleGridView -ErrorAction SilentlyContinue) {
        $chartData | Out-ConsoleGridView -Title "Release Branches per Project"
    } else {
        $chartData | Format-Table -AutoSize
    }
} else {
    Write-Host "No release branches found in any of the specified projects."
}
