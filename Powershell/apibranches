<#
.SYNOPSIS
    Script to analyze GitLab projects for release branches, their status, and merge requests.
.DESCRIPTION
    This script uses the GitLab API to gather information about branches starting with "rel"
    across multiple projects, including their last commit details and merge request status.
.NOTES
    Requires:
    - GitLab Personal Access Token with appropriate permissions
    - PowerShell 5.1 or later
#>

# Configuration
$GitLabUrl = "https://gitlab.example.com" # Replace with your GitLab instance URL
$AccessToken = "your-personal-access-token" # Replace with your PAT
$ProjectIds = @(123, 456, 789) # Replace with your project IDs

# Headers for API requests
$headers = @{
    "PRIVATE-TOKEN" = $AccessToken
}

# Initialize results array
$results = @()

# Function to get project name by ID
function Get-ProjectName {
    param($projectId)
    try {
        $response = Invoke-RestMethod -Uri "$GitLabUrl/api/v4/projects/$projectId" -Headers $headers -Method Get
        return $response.name
    }
    catch {
        Write-Warning "Failed to get project name for ID $projectId : $_"
        return "Unknown Project"
    }
}

# Function to get branches starting with 'rel'
function Get-ReleaseBranches {
    param($projectId)
    try {
        $branches = Invoke-RestMethod -Uri "$GitLabUrl/api/v4/projects/$projectId/repository/branches?search=^rel" -Headers $headers -Method Get
        return $branches
    }
    catch {
        Write-Warning "Failed to get branches for project $projectId : $_"
        return $null
    }
}

# Function to get open merge requests for a branch
function Get-OpenMergeRequests {
    param($projectId, $branchName)
    try {
        $mrs = Invoke-RestMethod -Uri "$GitLabUrl/api/v4/projects/$projectId/merge_requests?state=opened&source_branch=$branchName" -Headers $headers -Method Get
        return $mrs
    }
    catch {
        Write-Warning "Failed to get merge requests for branch $branchName in project $projectId : $_"
        return $null
    }
}

# Function to get last commit details
function Get-LastCommit {
    param($projectId, $branchName)
    try {
        $commit = Invoke-RestMethod -Uri "$GitLabUrl/api/v4/projects/$projectId/repository/branches/$branchName" -Headers $headers -Method Get
        return $commit.commit
    }
    catch {
        Write-Warning "Failed to get last commit for branch $branchName in project $projectId : $_"
        return $null
    }
}

# Main processing
foreach ($projectId in $ProjectIds) {
    $projectName = Get-ProjectName -projectId $projectId
    $branches = Get-ReleaseBranches -projectId $projectId

    if ($branches) {
        foreach ($branch in $branches) {
            $branchName = $branch.name
            $lastCommit = Get-LastCommit -projectId $projectId -branchName $branchName
            $mergeRequests = Get-OpenMergeRequests -projectId $projectId -branchName $branchName

            $hasOpenMRs = if ($mergeRequests -and $mergeRequests.Count -gt 0) { "Yes" } else { "No" }
            $mrCount = if ($mergeRequests) { $mergeRequests.Count } else { 0 }

            $result = [PSCustomObject]@{
                ProjectName    = $projectName
                ProjectId      = $projectId
                BranchName     = $branchName
                LastCommitDate = if ($lastCommit) { $lastCommit.committed_date } else { "Unknown" }
                LastAuthor     = if ($lastCommit) { $lastCommit.author_name } else { "Unknown" }
                LastMessage    = if ($lastCommit) { $lastCommit.message.Trim() } else { "Unknown" }
                HasOpenMRs     = $hasOpenMRs
                MRCount        = $mrCount
            }

            $results += $result
        }
    }
    else {
        $result = [PSCustomObject]@{
            ProjectName    = $projectName
            ProjectId      = $projectId
            BranchName     = "No release branches found"
            LastCommitDate = "N/A"
            LastAuthor     = "N/A"
            LastMessage    = "N/A"
            HasOpenMRs     = "N/A"
            MRCount        = 0
        }
        $results += $result
    }
}

# Output results as a formatted table
$results | Format-Table -AutoSize -Wrap -Property `
    @{Label="Project"; Expression={$_.ProjectName}; Width=25},
    @{Label="Branch"; Expression={$_.BranchName}; Width=20},
    @{Label="Last Author"; Expression={$_.LastAuthor}; Width=20},
    @{Label="Last Commit"; Expression={$_.LastCommitDate}; Width=25},
    @{Label="Open MRs"; Expression={$_.HasOpenMRs}; Width=10},
    @{Label="MR Count"; Expression={$_.MRCount}; Width=10},
    @{Label="Last Message"; Expression={$_.LastMessage}; Width=40}

# Optionally export to CSV
# $results | Export-Csv -Path "GitLabReleaseBranchesReport.csv" -NoTypeInformation
